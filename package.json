{
  "name": "majiang",
  "version": "1.0.0",
  "description": "广东麻将命令行游戏",
  "main": "dist/majiang/index.js",
  "scripts": {
    "start": "node dist/majiang/index.js",
    "build": "tsc",
    "dev": "ts-node src/majiang/index.ts",
    "test": "mocha -r ts-node/register tests/**/*.test.ts",
    "test:watch": "mocha -r ts-node/register --watch tests/**/*.test.ts",
    "tic-tac-toe": "ts-node src/tic-tac-toe/demo.ts",
    "ai:tic-tac-toe:test": "ts-node src/ai/test-tic-tac-toe-ai.ts",
    "ai:compare-batch": "ts-node src/ai/compare-ai-batch.ts",
    "ai:train-qlearning-agent": "ts-node src/ai/train-qlearning-agent.ts",
    "ai:train-qlearning-logged": "ts-node src/tic-tac-toe/strategy/train-qlearning-logged.ts",
    "ai:evaluate-agents-batch": "ts-node src/ai/evaluate-agents-batch.ts",
    "ai:analyze-qtable": "ts-node src/ai/analyze-qtable.ts",
    "ai:visualize-strategy": "ts-node src/ai/visualize-strategy.ts",
    "ai-assistant:mvp": "ts-node scripts/tic-tac-toe/mvp.ts",
    "othello:cli": "npx ts-node src/othello/othello-cli.ts",
    "othello:api-server": "npx ts-node src/othello/othello-api-server.ts",
    "othello:demo": "npx ts-node src/othello/othello-demo.ts",
    "othello:program-guide": "npx ts-node src/othello/program-guide.ts",
    "othello:run-commands": "npx ts-node src/othello/run-commands.ts",
    "othello:interactive": "npx ts-node src/othello/run-commands.ts --interactive",
    "othello:alphazero-train": "npx ts-node -e \"import('./src/othello/strategy/alphazero-trainer.ts').then(m => m.runTraining())\"",
    "othello:alphazero-smart-train": "npx ts-node -e \"import('./src/othello/strategy/alphazero-training-manager.ts').then(m => m.runSmartTraining())\"",
    "othello:alphazero-hyperopt": "npx ts-node -e \"import('./src/othello/strategy/alphazero-hyperopt.ts').then(m => m.runHyperoptimization())\"",
    "othello:alphazero-benchmark": "npx ts-node -e \"import('./src/othello/strategy/alphazero-benchmark.ts').then(m => m.runBenchmark())\"",
    "othello:alphazero-config": "npx ts-node src/othello/alphazero-config-guide.ts",
    "othello:dqn-train": "npx ts-node -e \"import('./src/othello/strategy/dqn-trainer.ts').then(m => m.runTraining())\"",
    "othello:a3c-train": "npx ts-node -e \"import('./src/othello/strategy/a3c-trainer').then(m => m.runTraining())\"",
    "othello:a3c-train-optimized": "npx ts-node -e \"import('./src/othello/strategy/a3c-trainer').then(m => m.runOptimizedTraining())\"",
    "othello:a3c-train-structured": "npx ts-node -e \"import('./src/othello/strategy/a3c-trainer').then(m => m.runStructuredTraining())\"",
    "othello:a3c-mcp": "npx ts-node src/othello/strategy/a3c-mcp-trainer.ts",
    "othello:a3c-mcp-quick": "npx ts-node src/othello/strategy/a3c-mcp-trainer.ts quick",
    "othello:a3c-mcp-standard": "npx ts-node src/othello/strategy/a3c-mcp-trainer.ts standard",
    "othello:a3c-mcp-full": "npx ts-node src/othello/strategy/a3c-mcp-trainer.ts full",
    "othello:a3c-demo-original": "npx ts-node src/othello/strategy/a3c-demo-trainer.ts original",
    "othello:a3c-demo-optimized": "npx ts-node src/othello/strategy/a3c-demo-trainer.ts optimized",
    "othello:a3c-demo-structured": "npx ts-node src/othello/strategy/a3c-demo-trainer.ts structured",
    "othello:a3c-safe": "npx ts-node -e \"import('./src/othello/strategy/a3c-trainer-safe').then(m => m.runSafeA3CTraining())\"",
    "othello:a3c-safe-structured": "npx ts-node -e \"import('./src/othello/strategy/a3c-trainer-safe').then(m => m.runStructuredA3CTraining())\"",
    "othello:a3c-safe-console": "npx ts-node -e \"import('./src/othello/strategy/a3c-trainer-safe').then(m => m.runConsoleA3CTraining())\"",
    "othello:alphazero-battle": "npx ts-node -e \"import('./src/othello/strategy/alphazero-agent.ts').then(m => m.runHumanVsAI())\"",
    "othello:alphazero-ai-battle": "npx ts-node -e \"import('./src/othello/strategy/alphazero-agent.ts').then(m => m.runAIVsAI())\"",
    "othello:strategies-test": "npx ts-node -e \"import('./src/othello/strategy/index.ts').then(m => m.runStrategyComparison())\"",
    "othello:alphazero-mcp": "npx ts-node src/othello/strategy/run-alphazero-mcp.ts",
    "othello:alphazero-mcp-quick": "npx ts-node src/othello/strategy/run-alphazero-mcp.ts quick",
    "othello:alphazero-mcp-standard": "npx ts-node src/othello/strategy/run-alphazero-mcp.ts standard",
    "othello:alphazero-mcp-ultra": "npx ts-node src/othello/strategy/run-alphazero-mcp.ts ultra",
    "othello:alphazero-mcp-hyper": "npx ts-node src/othello/strategy/run-alphazero-mcp.ts hyper",
    "othello:alphazero-mcp-demo": "npx ts-node src/othello/strategy/alphazero-mcp-demo.ts",
    "othello:alphazero-mcp-demo-quick": "npx ts-node src/othello/strategy/alphazero-mcp-demo.ts 3",
    "othello:alphazero-mcp-demo-full": "npx ts-node src/othello/strategy/alphazero-mcp-demo.ts 10",
    "othello:alphazero-mcp-real": "npx ts-node src/othello/strategy/alphazero-mcp-real-trainer.ts",
    "othello:alphazero-mcp-real-quick": "npx ts-node src/othello/strategy/alphazero-mcp-real-trainer.ts quick",
    "othello:alphazero-mcp-real-standard": "npx ts-node src/othello/strategy/alphazero-mcp-real-trainer.ts standard",
    "othello:alphazero-mcp-real-full": "npx ts-node src/othello/strategy/alphazero-mcp-real-trainer.ts full",
    "othello:alphazero-dc-mcp": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander.ts",
    "othello:alphazero-dc-mcp-quick": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander.ts quick",
    "othello:alphazero-dc-mcp-standard": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander.ts standard",
    "othello:alphazero-dc-mcp-full": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander.ts full",
    "othello:alphazero-dc-mcp-real": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander-real.ts",
    "othello:alphazero-dc-mcp-real-quick": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander-real.ts quick",
    "othello:alphazero-dc-mcp-real-standard": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander-real.ts standard",
    "othello:alphazero-dc-mcp-real-full": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander-real.ts full",
    "othello:alphazero-dc-mcp-real-ultra": "npx ts-node src/othello/strategy/alphazero-mcp-desktop-commander-real.ts ultra",
    "othello:alphazero-optimized": "npx ts-node src/othello/strategy/alphazero-mcp-optimized.ts"
  },
  "keywords": [
    "majiang",
    "game",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/sinon": "^17.0.4",
    "chai": "^4.5.0",
    "mocha": "^11.1.0",
    "sinon": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
