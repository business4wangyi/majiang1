    "@types/proxyquire": "^1.3.31",
    "@types/readline-sync": "^1.4.8",
    "@types/sinon": "^17.0.4",
    "chai": "^4.5.0",
    "chai-spies": "^1.0.0",
    "mocha": "^11.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
