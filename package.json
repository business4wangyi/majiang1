    "ai:evaluate-agents-batch": "ts-node src/ai/evaluate-agents-batch.ts",
    "ai:analyze-qtable": "ts-node src/ai/analyze-qtable.ts",
    "ai:visualize-strategy": "ts-node src/ai/visualize-strategy.ts",
    "othello:train-eval": "ts-node src/othello/othello-train-eval.ts",
